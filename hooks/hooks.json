{
  "description": "ECE plugin hooks: load the user's ECE notes at session start, and warn when a saved document contains sensitive personal numbers.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/load-user-notes.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/privacy-warning.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
